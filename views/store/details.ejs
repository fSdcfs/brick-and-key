<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Property Details</title>
</head>

<body style="margin: 0; padding: 40px; font-family: 'Segoe UI', sans-serif; background-color: #f4f4f4; display: flex; flex-direction: column; align-items: center; min-height: 100vh;">

  <!-- Heading -->
 <h1 style="width: 100%; text-align: center; font-size: 1.8rem; font-weight: 600; color: #2c2c2c; margin-bottom: 40px; padding: 12px 0; background-color: #e9f0ff; border-top: 2px solid #007bff; border-bottom: 2px solid #007bff; box-shadow: 0 2px 6px rgba(0,0,0,0.05);">
  🏡 Details of: <span style="color: #007bff;"><%= item.title %></span>
</h1>

  <!-- Subtitle -->
  <p style="text-align: center; color: #555; font-size: 1rem; margin-bottom: 40px;">
    Explore the full listing, features, and vibe of this property at BRICK & KEY.
  </p>

  <!-- Property Card -->
  <div style="width: 320px; background-color: white; border-radius: 10px; box-shadow: 0 6px 16px rgba(0,0,0,0.1); padding: 20px; transition: transform 0.3s;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
    
    <img src="<%= item.photo %>" alt="Property Image" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px; margin-bottom: 16px;">

    <h3 style="margin-top: 0; color: #333; font-size: 1.4rem;"><%= item.title %></h3>
    <p style="margin: 8px 0; color: #666;"><strong>📍 Location:</strong> <%= item.location %></p>
    <p style="margin: 8px 0; color: #666;"><strong>💰 Price:</strong> ₹<%= item.price %></p>
    <p style="margin: 8px 0; color: #666;"><strong>🏷️ Type:</strong> <%= item.type %></p>
    <p style="margin: 8px 0; color: #666;"><strong>📝 Description:</strong> <%= item.description %></p>
  </div>
  

  <!-- Back Button -->
  <div style="margin-top: 40px;">
    <a href="/store" style="text-decoration: none; color: white; background-color: #007bff; padding: 10px 20px; border-radius: 6px; font-weight: 500; box-shadow: 0 2px 6px rgba(0,0,0,0.1); transition: background-color 0.3s;" onmouseover="this.style.backgroundColor='#0056b3'" onmouseout="this.style.backgroundColor='#007bff'">
      ← Back to Store
    </a>
    
  </div>

</body>
</html>